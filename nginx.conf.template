# nginx داخل حاوية الواجهة: ملفات React الساكنة + تمرير /api إلى الباك اند.
# قالب: ${API_UPSTREAM} يُستبدل عند إقلاع الحاوية بقيمة متغير البيئة (افتراضياً host.docker.internal:5000).
server {
    listen 5001;
    server_name 163.245.221.210 _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # الباك اند (منفذ 5000 على المضيف افتراضياً — انظر API_UPSTREAM في docker-compose.yml)
    location /api/ {
        # رفع لوغو المكتب (حتى 20MB) — افتراضي nginx هو 1MB فيعيد 413 قبل أن يصل الطلب إلى الباك اند
        client_max_body_size 25m;
        proxy_pass http://${API_UPSTREAM}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # ملفات Vite المبنية تحمل hash في اسمها ⇒ تخزين مؤقت طويل
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # تطبيق صفحة واحدة: أي مسار آخر يعود إلى index.html (React Router)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
